---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import FAQ from '../components/FAQ.astro';
import HowWeTested from '../components/HowWeTested.astro';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
  readTime?: string;
  faq?: FaqItem[];
  platform?: string;
  sources?: { label: string; url: string }[];
  howWeTested?: boolean;
  disclosure?: boolean;
  // Post slug — used to build the per-post Apple campaign-link token (`b-<slug>`) for
  // the bottom DownloadCTA. See src/lib/campaigns.ts.
  slug?: string;
}

const { title, description, pubDate, updatedDate, author, tags = [], image, imageAlt, readTime, faq, slug, platform, sources = [], howWeTested = false, disclosure = false } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  timeZone: 'UTC', // date-only frontmatter values parse as UTC midnight; format in UTC so the day never slips
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Day-precision "Updated" row (2026-09-09, docs/content-plan-60d-2026-08.md §4
// "Dates" rule) — shown only when updatedDate is strictly later than pubDate, so a
// post with no substantive edit keeps today's unlabeled single-date row unchanged.
// Held as a single Date-or-null (not a separate boolean) so TS narrows it correctly
// wherever it's used below.
const shownUpdatedDate: Date | null =
  updatedDate && updatedDate.valueOf() > pubDate.valueOf() ? updatedDate : null;
const formattedUpdatedDate = shownUpdatedDate
  ? shownUpdatedDate.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })
  : '';

// Official profiles only: the App Store listing. Add others here only once they exist.
const orgNode = {
  '@type': 'Organization',
  name: 'LockPact',
  url: 'https://lockpact.app',
  sameAs: ['https://apps.apple.com/app/lockpact/id6759302382'],
};

const blogPostingData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  author: orgNode,
  datePublished: pubDate.toISOString(),
  // dateModified can never precede datePublished (a mis-set updatedDate used to produce that).
  dateModified: new Date(Math.max((updatedDate ?? pubDate).valueOf(), pubDate.valueOf())).toISOString(),
  publisher: orgNode,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
};

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lockpact.app/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://lockpact.app/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};

// FAQPage JSON-LD, emitted only when frontmatter `faq` is present. Google retired the
// FAQ rich-result feature for Search in 2026 (no more expandable snippets), so this no
// longer buys classic rich-result real estate — it's kept as a machine-readable answer
// set for non-Google answer engines (AI Overviews, Bing/ChatGPT retrieval, Perplexity,
// Claude) that still parse FAQPage for extraction. BaseLayout renders `structuredData`
// as a single <script type="application/ld+json"> containing a JSON array of root
// nodes (not a @graph wrapper) — appending here follows that existing convention.
const plainAnswer = (v: string) => v.replace(/\*\*([^*]+)\*\*/g, '$1').replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '$1');

const faqPageData = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          // Same text the visible FAQ shows, with [text](url) link syntax and ** stripped.
          text: plainAnswer(item.a),
        },
      })),
    }
  : null;

const structuredData = faqPageData
  ? [blogPostingData, breadcrumbData, faqPageData]
  : [blogPostingData, breadcrumbData];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  structuredData={structuredData}
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <Nav />
  <main class="max-w-[720px] mx-auto px-6 py-16 md:py-24">
    <article>
      <nav aria-label="Breadcrumb" class="text-sm mb-6" style="color: var(--color-text-tertiary);">
        <a href="/" style="color: var(--color-text-tertiary);">Home</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <a href="/blog/" style="color: var(--color-text-tertiary);">Guides</a>
        <span aria-hidden="true"> &rsaquo; </span>
        <span aria-current="page">{title}</span>
      </nav>
      <header class="mb-10">
        <p class="text-sm mb-4" style="color: var(--color-text-tertiary);">
          {shownUpdatedDate ? (
            <>Updated <time datetime={shownUpdatedDate.toISOString()}>{formattedUpdatedDate}</time></>
          ) : (
            <>Published <time datetime={pubDate.toISOString()}>{formattedDate}</time></>
          )}
          {platform && <> &middot; {platform}</>}
          {readTime && <> &middot; {readTime}</>}
        </p>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight mb-4" style="color: var(--color-text-primary);">
          {title}
        </h1>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span
                class="text-xs font-medium px-2.5 py-1 rounded-full"
                style="background: var(--color-accent-soft); color: var(--color-accent);"
              >
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      {disclosure && (
        <p class="text-sm mb-8 px-4 py-3 rounded-lg" style="background: var(--color-accent-soft); color: var(--color-text-secondary);">
          We make LockPact, one of the apps listed. <a href="/editorial-policy/">How we review</a>.
        </p>
      )}

      <div class="prose max-w-none">
        <slot />
      </div>

      {howWeTested && <HowWeTested checkedOn={shownUpdatedDate ? formattedUpdatedDate : formattedDate} sources={sources} />}

      {faq && faq.length > 0 && (
        <div class="prose max-w-none">
          <FAQ variant="post" items={faq.map((f) => ({ question: f.q, answer: f.a }))} />
        </div>
      )}
    </article>

    <div class="mt-16">
      <DownloadCTA campaign={slug ? `b-${slug}` : undefined} />
    </div>
  </main>
  <Footer />
</BaseLayout>
