---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DownloadCTA from '../components/DownloadCTA.astro';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
  readTime?: string;
  faq?: FaqItem[];
}

const { title, description, pubDate, updatedDate, author, tags = [], image, imageAlt, readTime, faq } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const blogPostingData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'LockPact',
    url: 'https://lockpact.app',
  },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  publisher: {
    '@type': 'Organization',
    name: 'LockPact',
    url: 'https://lockpact.app',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
};

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lockpact.app/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://lockpact.app/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.url.href },
  ],
};

// FAQPage JSON-LD, emitted only when frontmatter `faq` is present. Google retired the
// FAQ rich-result feature for Search in 2026 (no more expandable snippets), so this no
// longer buys classic rich-result real estate — it's kept as a machine-readable answer
// set for non-Google answer engines (AI Overviews, Bing/ChatGPT retrieval, Perplexity,
// Claude) that still parse FAQPage for extraction. BaseLayout renders `structuredData`
// as a single <script type="application/ld+json"> containing a JSON array of root
// nodes (not a @graph wrapper) — appending here follows that existing convention.
const faqPageData = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    }
  : null;

const structuredData = faqPageData
  ? [blogPostingData, breadcrumbData, faqPageData]
  : [blogPostingData, breadcrumbData];
---

<BaseLayout
  title={`${title} | LockPact Blog`}
  description={description}
  ogType="article"
  structuredData={structuredData}
>
  <Nav />
  <main class="max-w-[720px] mx-auto px-6 py-16 md:py-24">
    <article>
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 text-sm mb-4" style="color: var(--color-text-tertiary);">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {readTime && (
            <>
              <span>&middot;</span>
              <span>{readTime}</span>
            </>
          )}
          <span>&middot;</span>
          <span>{author}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight mb-4" style="color: var(--color-text-primary);">
          {title}
        </h1>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span
                class="text-xs font-medium px-2.5 py-1 rounded-full"
                style="background: var(--color-accent-soft); color: var(--color-accent);"
              >
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="prose max-w-none">
        <slot />
      </div>
    </article>

    <div class="mt-16">
      <DownloadCTA />
    </div>
  </main>
  <Footer />
</BaseLayout>
