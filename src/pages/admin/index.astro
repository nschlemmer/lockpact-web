---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LockPact / admin"
  description="Internal analytics dashboard."
  noindex={true}
>
  <div class="wrap" id="admin-page">
    <div id="signin-gate" class="signin-gate">
      <h1 class="signin-title">Lock<span>Pact</span> <span class="muted">/ admin</span></h1>
      <p id="signin-status" class="signin-status">Sign in with the Apple ID you use for the LockPact app.</p>
      <button id="signin-btn" class="signin-btn">Sign in with Apple</button>
    </div>

    <div id="dashboard" class="dashboard" style="display: none;">
      <header class="admin-header">
        <div class="logo">Lock<span>Pact</span> <span class="muted">/ admin</span></div>
        <div class="header-right">
          <div class="range" id="range-toggle">
            <button data-p="7d">7d</button><button data-p="30d" class="active">30d</button><button data-p="90d">90d</button><button data-p="all">All time</button>
          </div>
          <div class="date-range">
            <input type="date" id="range-start" aria-label="Custom range start" />
            <span>–</span>
            <input type="date" id="range-end" aria-label="Custom range end" />
          </div>
          <span class="pill" id="whoami">···</span>
          <button id="signout-btn" class="text-btn">Sign out</button>
        </div>
      </header>
      <div class="compare-note" id="cmp">Loading…</div>

      <section>
        <div class="sec-head"><h2>Focus signals</h2><span class="src">auto-computed — biggest movers vs previous period, tagged where to act</span></div>
        <div class="card" id="signals"><div class="row"><span class="k muted">Loading…</span></div></div>
      </section>

      <section>
        <div class="sec-head"><h2>Lifetime totals</h2><span class="src">all time since launch — unaffected by the period filter</span></div>
        <div class="totals" id="lifetime-totals"></div>
      </section>

      <section>
        <div class="sec-head"><h2>Product health</h2><span class="src">source: <b>Firestore</b> · authoritative</span><span class="cache" id="ph-cache"></span></div>
        <div class="grid g4" style="margin-bottom: 12px;" id="ph-cards"></div>
        <div class="grid g2">
          <div class="card">
            <div class="kpi-label" style="margin-bottom: 10px;">How pacts end</div>
            <div id="pact-bars"></div>
          </div>
          <div class="card">
            <div class="kpi-label" style="margin-bottom: 6px;">Unlock requests &amp; locking activity</div>
            <div id="unlock-response-row"></div>
            <div id="unlock-rows"></div>
          </div>
        </div>
      </section>

      <section>
        <div class="sec-head"><h2>Acquisition</h2><span class="src">sources: <b>Vercel · App Store Connect · Firestore</b></span></div>
        <div class="card" style="margin-bottom: 12px;">
          <div class="funnel" id="funnel"></div>
          <div class="footnote" id="funnel-note"></div>
        </div>
        <div class="grid g2">
          <div class="card">
            <div class="kpi-label" style="margin-bottom: 6px;">Where downloads come from <span class="tech">ASC page-view analytics</span></div>
            <div id="asc-rows"></div>
          </div>
          <div class="card">
            <div class="kpi-label" style="margin-bottom: 6px;">Website traffic → store</div>
            <div id="web-rows"></div>
          </div>
        </div>
      </section>

      <section>
        <div class="sec-head"><h2>Engagement &amp; retention</h2><span class="src">source: <b>GA4</b></span></div>
        <div class="grid g3" style="margin-bottom: 12px;" id="eng-cards"></div>
        <div class="grid g2">
          <div class="card">
            <div class="kpi-label" style="margin-bottom: 10px;">First-run journey — where new users drop</div>
            <div id="onb-bars"></div>
          </div>
          <div class="card">
            <div class="kpi-label" style="margin-bottom: 10px;">Invite loop — does the product spread itself</div>
            <div id="inv-bars"></div>
          </div>
        </div>
      </section>

      <section>
        <div class="sec-head"><h2>Revenue</h2><span class="src">sources: <b>AdMob API · App Store Connect sales (GA4 shown as a secondary signal)</b></span></div>
        <div class="grid g4" id="rev-cards"></div>
      </section>

      <section>
        <div class="sec-head"><h2>Quality &amp; sentiment</h2><span class="src">source: <b>App Store Connect</b> (public feeds)</span></div>
        <div class="grid g3" style="margin-bottom: 12px;" id="qual-cards"></div>
        <div class="card">
          <div class="kpi-label" style="margin-bottom: 4px;">Recent reviews</div>
          <div id="qual-reviews"></div>
        </div>
      </section>

      <section>
        <div class="sec-head"><h2>Claude snapshot</h2><span class="src">the optimization feed — every metric above, machine-readable</span></div>
        <div class="card">
          <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <button class="snap-btn" id="snap-btn">Copy snapshot for Claude</button>
            <span style="font-size: 12.5px; color: var(--color-text-tertiary);">Markdown export for the selected period. Also served at <span class="tech">/api/admin/snapshot?period=</span></span>
          </div>
          <pre class="snap" id="snap-prev" style="display: none;"></pre>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Adapted from docs/phase-1.5/mockups/admin-dashboard-mockup.html, using
     this site's existing CSS custom properties instead of the mockup's
     standalone palette.

     is:global + a leading #admin-page selector prefix on every rule (rather
     than Astro's default per-component scoping): the dashboard's content is
     built as HTML strings and injected via .innerHTML from the script
     block below, entirely outside Astro's compiler pass, so those nodes
     never receive the data-astro-cid-* attribute scoped CSS depends on —
     every scoped rule silently failed to match anything injected after
     load (confirmed via the compiled build output). #admin-page is a real,
     unique DOM id that exists only on this route, so prefixing with it
     keeps every rule exactly as collision-safe as Astro's own scoping
     would have been, without depending on the compiler ever seeing the
     elements these rules need to match. */
  #admin-page.wrap { max-width: 1120px; margin: 0 auto; padding: 24px 20px 64px; }

  #admin-page .signin-gate { min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center; }
  #admin-page .signin-title { font-size: 20px; font-weight: 700; color: var(--color-text-primary); }
  #admin-page .signin-title span:not(.muted) { color: var(--color-accent); }
  #admin-page .signin-title span.muted { color: var(--color-text-tertiary); font-weight: 400; }
  #admin-page .signin-status { color: var(--color-text-secondary); font-size: 14px; max-width: 420px; }
  #admin-page .signin-btn { background: #000; color: #fff; border-radius: 10px; padding: 12px 22px; font-size: 14px; font-weight: 600; cursor: pointer; border: 0; }

  #admin-page .admin-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--color-card-border); margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
  #admin-page .logo { font-weight: 700; font-size: 17px; color: var(--color-text-primary); }
  #admin-page .logo span.muted { color: var(--color-text-tertiary); font-weight: 400; }
  #admin-page .logo span:not(.muted) { color: var(--color-accent); }
  #admin-page .header-right { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--color-text-secondary); flex-wrap: wrap; }
  #admin-page .range { display: flex; border: 1px solid var(--color-card-border); border-radius: 8px; overflow: hidden; }
  #admin-page .range button { background: transparent; border: 0; color: var(--color-text-secondary); padding: 6px 14px; font-size: 13px; cursor: pointer; font-family: inherit; }
  #admin-page .range button.active { background: var(--color-accent); color: #fff; }
  #admin-page .date-range { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--color-text-secondary); }
  #admin-page .date-range input[type="date"] { background: transparent; border: 1px solid var(--color-card-border); border-radius: 6px; padding: 4px 6px; color: var(--color-text-primary); font-size: 12.5px; font-family: inherit; }
  #admin-page .pill { border: 1px solid var(--color-card-border); border-radius: 999px; padding: 4px 12px; }
  #admin-page .text-btn { background: transparent; border: 0; color: var(--color-text-tertiary); font-size: 12.5px; cursor: pointer; text-decoration: underline; font-family: inherit; }
  #admin-page .compare-note { font-size: 12px; color: var(--color-text-tertiary); margin-bottom: 20px; }

  #admin-page section { margin-bottom: 30px; }
  #admin-page .sec-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  #admin-page .sec-head h2 { font-size: 15px; font-weight: 600; color: var(--color-text-primary); }
  #admin-page .src { font-size: 11px; color: var(--color-text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  #admin-page .src b { color: var(--color-text-secondary); font-weight: 500; }
  #admin-page .cache { margin-left: auto; font-size: 11.5px; color: var(--color-text-tertiary); }

  #admin-page .grid { display: grid; gap: 12px; }
  #admin-page .g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  #admin-page .g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 800px) {
    #admin-page .g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #admin-page .g2 { grid-template-columns: 1fr; }
  }
  #admin-page .card { background: var(--color-card); border: 1px solid var(--color-card-border); border-radius: 14px; padding: 16px 18px; }
  #admin-page .kpi-label { font-size: 12.5px; color: var(--color-text-secondary); margin-bottom: 6px; }
  #admin-page .kpi-value { font-size: 25px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-text-primary); }
  #admin-page .kpi-sub { font-size: 11.5px; color: var(--color-text-tertiary); margin-top: 4px; }
  #admin-page .delta { font-size: 12px; font-weight: 600; margin-left: 6px; }
  #admin-page .up { color: var(--color-unlocked); }
  #admin-page .down { color: var(--color-locked); }
  #admin-page .warn { color: #F59E0B; }
  #admin-page .flat { color: var(--color-text-tertiary); }

  #admin-page .row { display: flex; justify-content: space-between; font-size: 13px; padding: 5px 0; border-bottom: 1px solid var(--color-card-border); gap: 8px; }
  #admin-page .row:last-child { border-bottom: 0; }
  #admin-page .row .k { color: var(--color-text-secondary); }
  #admin-page .row .v { font-weight: 600; white-space: nowrap; color: var(--color-text-primary); }
  #admin-page .muted { color: var(--color-text-tertiary); font-weight: 400; }
  #admin-page .tech { font-size: 10.5px; color: var(--color-text-tertiary); font-family: 'JetBrains Mono', monospace; }

  #admin-page .bar-row { display: flex; align-items: center; gap: 10px; font-size: 12.5px; padding: 4px 0; }
  #admin-page .bar-row .lbl { width: 190px; color: var(--color-text-secondary); }
  #admin-page .bar-row .lbl .tech { display: block; }
  #admin-page .bar-track { flex: 1; background: var(--color-bg); border-radius: 4px; height: 15px; overflow: hidden; }
  #admin-page .bar-fill { background: var(--color-accent); height: 100%; border-radius: 4px; }
  #admin-page .bar-fill.g { background: var(--color-unlocked); }
  #admin-page .bar-row .pct { width: 56px; text-align: right; font-weight: 600; font-size: 12px; color: var(--color-text-primary); }

  #admin-page .badge { display: inline-block; font-size: 10.5px; padding: 2px 8px; border-radius: 999px; font-weight: 600; letter-spacing: 0.03em; }
  #admin-page .badge.dev { background: rgba(99, 102, 241, 0.18); color: var(--color-accent-hover); }
  #admin-page .badge.mkt { background: rgba(16, 185, 129, 0.15); color: var(--color-unlocked); }
  #admin-page .signal { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--color-card-border); font-size: 13px; }
  #admin-page .signal:last-child { border-bottom: 0; }
  #admin-page .signal .sev { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

  #admin-page .review { padding: 8px 0; border-bottom: 1px solid var(--color-card-border); font-size: 12.5px; }
  #admin-page .review:last-child { border-bottom: 0; }
  #admin-page .stars { color: #F59E0B; font-size: 12px; letter-spacing: 1px; }

  #admin-page .funnel { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; align-items: end; }
  #admin-page .f-bar { background: rgba(99, 102, 241, 0.35); border-top: 3px solid var(--color-accent); border-radius: 4px 4px 0 0; }
  #admin-page .f-num { font-size: 17px; font-weight: 700; margin-top: 8px; color: var(--color-text-primary); }
  #admin-page .f-lbl { font-size: 11.5px; color: var(--color-text-secondary); }
  #admin-page .f-conv { font-size: 11px; color: var(--color-text-tertiary); }
  #admin-page .footnote { font-size: 12px; color: var(--color-text-tertiary); margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--color-card-border); }

  #admin-page .snap-btn { background: var(--color-accent); border: 0; border-radius: 10px; color: #fff; padding: 10px 18px; font-size: 13.5px; font-weight: 600; cursor: pointer; font-family: inherit; }
  #admin-page pre.snap { background: var(--color-bg); border: 1px solid var(--color-card-border); border-radius: 10px; padding: 12px 14px; font-size: 11.5px; color: var(--color-text-secondary); font-family: 'JetBrains Mono', monospace; overflow-x: auto; margin-top: 12px; line-height: 1.55; white-space: pre-wrap; }

  #admin-page .totals { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 800px) { #admin-page .totals { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  #admin-page .tot { background: var(--color-card); border: 1px solid var(--color-card-border); border-radius: 12px; padding: 12px 14px; }
  #admin-page .tot .n { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-text-primary); }
  #admin-page .tot .l { font-size: 11.5px; color: var(--color-text-secondary); margin-top: 2px; }
  #admin-page .tot .s { font-size: 10.5px; color: var(--color-text-tertiary); margin-top: 2px; }
</style>

<script>
  import { initializeApp } from 'firebase/app';
  import { getAuth, OAuthProvider, signInWithPopup, onAuthStateChanged, signOut, type User } from 'firebase/auth';
  import { formatMinutes } from '../../lib/format';

  const firebaseConfig = {
    apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
    authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
    projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
    storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
    messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
    appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
  };
  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);

  const signinGate = document.getElementById('signin-gate') as HTMLElement;
  const signinStatus = document.getElementById('signin-status') as HTMLElement;
  const signinBtn = document.getElementById('signin-btn') as HTMLButtonElement;
  const dashboard = document.getElementById('dashboard') as HTMLElement;
  const signoutBtn = document.getElementById('signout-btn') as HTMLButtonElement;
  const whoami = document.getElementById('whoami') as HTMLElement;

  type WindowSelection =
    | { kind: 'preset'; period: string }
    | { kind: 'range'; start: string; end: string };

  let idToken: string | null = null;
  let currentWindow: WindowSelection = { kind: 'preset', period: '30d' };

  function windowQueryParams(w: WindowSelection): string {
    return w.kind === 'preset' ? `period=${w.period}` : `start=${w.start}&end=${w.end}`;
  }

  signinBtn.addEventListener('click', async () => {
    signinStatus.textContent = 'Opening sign-in…';
    try {
      const provider = new OAuthProvider('apple.com');
      await signInWithPopup(auth, provider);
    } catch (err: any) {
      console.error('[admin] Sign-in failed:', err);
      // Deliberately NOT falling back to signInWithRedirect — it's broken on
      // Safari 16.1+ (third-party storage partitioning) without an authDomain
      // reverse-proxy, and a silently-broken fallback is worse than an error.
      if (err?.code === 'auth/popup-blocked') {
        signinStatus.textContent = 'Your browser blocked the sign-in popup — allow popups for this site and try again.';
      } else if (err?.code === 'auth/operation-not-allowed') {
        signinStatus.textContent = 'Apple sign-in is not configured yet for this project (setup blocker, not a bug — see keys-guide step 1).';
      } else {
        signinStatus.textContent = `Sign-in failed (${err?.code ?? 'unknown error'}). Try again.`;
      }
    }
  });

  signoutBtn.addEventListener('click', () => {
    void signOut(auth);
  });

  onAuthStateChanged(auth, async (user: User | null) => {
    if (!user) {
      idToken = null;
      dashboard.style.display = 'none';
      signinGate.style.display = 'flex';
      return;
    }
    try {
      idToken = await user.getIdToken();
    } catch (err) {
      console.error('[admin] getIdToken failed:', err);
      signinStatus.textContent = 'Could not get a session token. Try signing in again.';
      return;
    }
    whoami.textContent = `${user.displayName || user.email || 'signed in'} · checking access…`;

    // authedFetchJson never throws, so this try/catch is a defensive backstop
    // only — no rejection should ever escape this callback.
    let result: 'show-dashboard' | 'unauthorized' | 'forbidden';
    try {
      result = await loadEverything();
    } catch (err) {
      console.error('[admin] loadEverything crashed unexpectedly:', err);
      result = 'show-dashboard';
    }

    if (result === 'show-dashboard') {
      signinGate.style.display = 'none';
      dashboard.style.display = 'block';
      whoami.textContent = `${user.displayName || user.email || 'admin'} · isAdmin`;
    } else {
      signinGate.style.display = 'flex';
      signinStatus.textContent =
        result === 'unauthorized'
          ? 'Session expired — sign in again.'
          : 'Signed in, but this account is not an admin.';
    }
  });

  type FetchOutcome<T> =
    | { kind: 'ok'; data: T }
    | { kind: 'unauthorized' }
    | { kind: 'forbidden' }
    | { kind: 'error'; status: number };

  // Never throws — every failure mode (no token, network error, non-2xx
  // status, unparseable body) resolves to a tagged outcome instead of a
  // rejection, so callers can render a definite state either way.
  async function authedFetchJson<T>(path: string): Promise<FetchOutcome<T>> {
    if (!idToken) return { kind: 'error', status: 0 };
    let res: Response;
    try {
      res = await fetch(path, { headers: { Authorization: `Bearer ${idToken}` } });
    } catch (err) {
      console.error(`[admin] network error fetching ${path}:`, err);
      return { kind: 'error', status: 0 };
    }
    if (res.status === 401) return { kind: 'unauthorized' };
    if (res.status === 403) return { kind: 'forbidden' };
    if (!res.ok) return { kind: 'error', status: res.status };
    try {
      return { kind: 'ok', data: (await res.json()) as T };
    } catch (err) {
      console.error(`[admin] failed to parse JSON from ${path}:`, err);
      return { kind: 'error', status: res.status };
    }
  }

  async function loadEverything(): Promise<'show-dashboard' | 'unauthorized' | 'forbidden'> {
    const liveOutcome = await authedFetchJson<any>('/api/admin/live');
    if (liveOutcome.kind === 'unauthorized') return 'unauthorized';
    if (liveOutcome.kind === 'forbidden') return 'forbidden';
    if (liveOutcome.kind === 'error') {
      renderLifetimeTotalsError(liveOutcome.status);
      renderCurrentStateError(liveOutcome.status);
    } else {
      renderLifetimeTotals(liveOutcome.data.lifetime, liveOutcome.data.lifetimeExternal);
      renderCurrentState(liveOutcome.data.current);
    }
    // A generic server error still shows the dashboard shell (per-section
    // failure states) rather than freezing on the sign-in gate — only an
    // auth-specific outcome (401/403) does that.
    await loadWindow(currentWindow);
    return 'show-dashboard';
  }

  async function loadWindow(w: WindowSelection) {
    currentWindow = w;
    const outcome = await authedFetchJson<any>(`/api/admin/metrics?${windowQueryParams(w)}`);
    if (outcome.kind === 'ok') {
      renderPeriodMetrics(outcome.data);
    } else if (outcome.kind === 'unauthorized' || outcome.kind === 'forbidden') {
      // Token died mid-session (e.g. expired while the dashboard was open) —
      // bounce back to the gate with the same messaging as the initial load.
      idToken = null;
      dashboard.style.display = 'none';
      signinGate.style.display = 'flex';
      signinStatus.textContent =
        outcome.kind === 'unauthorized'
          ? 'Session expired — sign in again.'
          : 'Signed in, but this account is not an admin.';
    } else {
      renderPeriodMetricsError(outcome.status);
    }
  }

  const rangeStartInput = document.getElementById('range-start') as HTMLInputElement;
  const rangeEndInput = document.getElementById('range-end') as HTMLInputElement;

  document.querySelectorAll<HTMLButtonElement>('#range-toggle button').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#range-toggle button').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      // Presets and the custom range are mutually exclusive — picking one clears the other.
      rangeStartInput.value = '';
      rangeEndInput.value = '';
      void loadWindow({ kind: 'preset', period: btn.dataset.p as string });
    });
  });

  function tryApplyCustomRange() {
    const start = rangeStartInput.value;
    const end = rangeEndInput.value;
    if (!start || !end) return;
    document.querySelectorAll('#range-toggle button').forEach((b) => b.classList.remove('active'));
    void loadWindow({ kind: 'range', start, end });
  }
  rangeStartInput.addEventListener('change', tryApplyCustomRange);
  rangeEndInput.addEventListener('change', tryApplyCustomRange);

  function fmtNum(n: number): string {
    return Math.round(n || 0).toLocaleString();
  }

  function fmtUsd(n: number): string {
    return `$${(n || 0).toFixed(2)}`;
  }

  function renderLifetimeTotals(l: any, ext: any) {
    const el = document.getElementById('lifetime-totals') as HTMLElement;
    const extAvail = ext?.available;
    const totalRevenueUsd = (ext?.adEarningsUsdTotal || 0) + (ext?.waiversAscUsdTotal || 0) + (ext?.supportAscUsdTotal || 0);
    const tiles: [string, string, string][] = [
      [extAvail ? fmtNum(ext.downloadsTotal) : '—', 'Downloads', extAvail ? 'App Store Connect' : 'connects once ASC access is set up'],
      [fmtNum(l.usersTotal), 'Users signed in', 'Firestore'],
      [fmtNum(l.partnershipsFormedTotal), 'Partnerships formed', 'Firestore'],
      [fmtNum(l.pactsTotal), 'Pacts made', `${fmtNum(l.pactsKeptToEnd)} kept to the end`],
      [fmtNum(l.lockSessionsTotal), 'Lock sessions', `≈${fmtNum(l.lockHoursTotal)} hours locked`],
      [fmtNum(l.unlockRequestsTotal), 'Unlock requests', `${fmtNum(l.unlockApprovedTotal)} approved`],
      [extAvail ? fmtNum(ext.adsWatchedTotal) : '—', 'Ads watched', extAvail ? 'AdMob impressions' : 'connects once AdMob is set up'],
      [fmtNum(l.bypassesDetectedTotal), 'Bypasses detected', `across ${fmtNum(l.bypassAffectedPairs)} pairs`],
      [fmtNum(l.invitesCreatedTotal), 'Invite codes created', 'Firestore'],
      [
        fmtNum(ext?.waiversAscTotal || 0),
        'Willpower Waivers',
        `${fmtUsd(ext?.waiversAscUsdTotal || 0)} (ASC) · GA4 events (incl. test purchases): ${fmtNum(ext?.purchaseCompleteTotal || 0)}`,
      ],
      [
        fmtNum(ext?.supportAscTotal || 0),
        'Support LockPact',
        `${fmtUsd(ext?.supportAscUsdTotal || 0)} (ASC) · GA4 events (incl. test purchases): ${fmtNum(ext?.tipSentTotal || 0)}`,
      ],
      [extAvail ? fmtUsd(totalRevenueUsd) : '—', 'Total revenue', 'ads + IAP (web/Stripe not included)'],
    ];
    el.innerHTML = tiles
      .map(([n, label, sub]) => `<div class="tot"><div class="n">${n}</div><div class="l">${label}</div><div class="s">${sub}</div></div>`)
      .join('');
  }

  function renderLifetimeTotalsError(status: number) {
    const el = document.getElementById('lifetime-totals') as HTMLElement;
    el.innerHTML = `<div class="tot" style="grid-column: 1 / -1;"><div class="l muted">Server error (HTTP ${status}) — data unavailable</div></div>`;
  }

  function renderCurrentState(c: any) {
    (document.getElementById('ph-cache') as HTMLElement).textContent = 'live';
    const el = document.getElementById('ph-cards') as HTMLElement;
    const cards: [string, string, string][] = [
      ['New + total users', `${fmtNum(c.usersTotal)}`, `${fmtNum(c.usersPaired)} paired (${(c.pairedPct || 0).toFixed(0)}%)`],
      ['Paired users', `${fmtNum(c.usersPaired)} · ${(c.pairedPct || 0).toFixed(0)}%`, ''],
      ['Engaged pairs (14d)', `${fmtNum(c.partnershipsEngaged14d)}`, 'had a lock or pact recently'],
      ['Bypass rate', `${(c.bypassRatePct || 0).toFixed(0)}%`, 'of active pairs'],
    ];
    el.innerHTML = cards
      .map(([label, value, sub]) => `<div class="card"><div class="kpi-label">${label}</div><div class="kpi-value">${value}</div><div class="kpi-sub">${sub}</div></div>`)
      .join('');

    const unlockEl = document.getElementById('unlock-rows') as HTMLElement;
    const sh = c.streakHistogram || { '0': 0, '1-3': 0, '4-7': 0, '8+': 0 };
    const rows: [string, string][] = [
      ['Currently locked pairs', fmtNum(c.currentlyLockedPairs)],
      ['Active pacts', fmtNum(c.activePacts)],
      ['Pending unlock requests', fmtNum(c.pendingUnlockRequests)],
      ['Streaks', `0: ${sh['0']} · 1-3: ${sh['1-3']} · 4-7: ${sh['4-7']} · 8+: ${sh['8+']}`],
    ];
    unlockEl.innerHTML = rows.map(([k, v]) => `<div class="row"><span class="k">${k}</span><span class="v">${v}</span></div>`).join('');
  }

  function renderCurrentStateError(status: number) {
    (document.getElementById('ph-cache') as HTMLElement).textContent = 'error';
    const errMsg = `<div class="row"><span class="k muted">Server error (HTTP ${status}) — data unavailable</span></div>`;
    (document.getElementById('ph-cards') as HTMLElement).innerHTML =
      `<div class="card" style="grid-column: 1 / -1;"><div class="kpi-label muted">Server error (HTTP ${status}) — data unavailable</div></div>`;
    (document.getElementById('unlock-rows') as HTMLElement).innerHTML = errMsg;
  }

  const REASON_LABELS: Record<string, string> = {
    timer_expired: 'Kept to the end',
    partner_approved: 'Partner released early',
    declined: 'Declined',
    partnership_dissolved: 'Partnership dissolved',
    superseded_by_pact: 'Superseded by new pact',
    orphaned_partnership_changed: 'Orphaned (partnership changed)',
    malformed: 'Malformed',
    account_deleted: 'Account deleted',
  };

  function renderPeriodMetrics(m: any) {
    (document.getElementById('cmp') as HTMLElement).textContent = m.compareNote;

    const signalsEl = document.getElementById('signals') as HTMLElement;
    if (!m.focusSignals || m.focusSignals.length === 0) {
      signalsEl.innerHTML = `<div class="row"><span class="k muted">No signals crossed threshold this period${m.hasData ? '' : ' — collecting data, first rollup pending'}.</span></div>`;
    } else {
      signalsEl.innerHTML = m.focusSignals
        .map((s: any) => {
          const sev = s.severity === 'red' ? 'var(--color-locked)' : s.severity === 'amber' ? '#F59E0B' : 'var(--color-unlocked)';
          return `<div class="signal"><span class="sev" style="background:${sev}"></span><span style="flex:1;">${s.text}</span><span class="badge ${s.tag}">${s.tag === 'dev' ? 'DEV' : 'MARKETING'}</span></div>`;
        })
        .join('');
    }

    const ph = m.productHealth;

    const responseEl = document.getElementById('unlock-response-row') as HTMLElement;
    responseEl.innerHTML = `<div class="row"><span class="k">Median partner response</span><span class="v">${formatMinutes(ph.unlockResponseMinutesMedian || 0)}</span></div>`;

    const pactBarsEl = document.getElementById('pact-bars') as HTMLElement;
    const total = ph.pactsEnded || 0;
    const bars = Object.entries(ph.pactsEndedByReason || {})
      .filter(([, v]: any) => v > 0)
      .map(([reason, count]: any) => {
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        return `<div class="bar-row"><span class="lbl">${REASON_LABELS[reason] ?? reason}<span class="tech">${reason}</span></span><div class="bar-track"><div class="bar-fill ${reason === 'timer_expired' ? 'g' : ''}" style="width:${pct}%"></div></div><span class="pct">${pct}%</span></div>`;
      });
    pactBarsEl.innerHTML = bars.length > 0 ? bars.join('') : '<div class="row"><span class="k muted">No pacts ended this period.</span></div>';

    renderEngagement(m);
    renderRevenue(m);
    renderAcquisition(m);
    renderQuality(m);
  }

  function funnelBars(stages: [string, string, number][], total: number, emptyMsg: string): string {
    if (total <= 0) return `<div class="row"><span class="k muted">${emptyMsg}</span></div>`;
    return stages
      .map(([label, tech, count]) => {
        const pct = Math.round((count / total) * 100);
        return `<div class="bar-row"><span class="lbl">${label}<span class="tech">${tech}</span></span><div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div><span class="pct">${pct}%</span></div>`;
      })
      .join('');
  }

  function renderEngagement(m: any) {
    const eng = m.engagement;
    const cardsEl = document.getElementById('eng-cards') as HTMLElement;
    const onbEl = document.getElementById('onb-bars') as HTMLElement;
    const invEl = document.getElementById('inv-bars') as HTMLElement;

    if (!eng?.available) {
      cardsEl.innerHTML = '<div class="card" style="grid-column: 1 / -1;"><div class="kpi-label muted">Connects once GA4 access is granted (keys-guide step 4) — not yet flowing.</div></div>';
      onbEl.innerHTML = '';
      invEl.innerHTML = '';
      return;
    }

    const cards: [string, string, string][] = [
      ['Daily active users', fmtNum(eng.dailyActiveUsers), 'latest day with GA4 data'],
      ['New users (period)', fmtNum(eng.newUsers), ''],
      ['Screen Time permission denial rate', `${(eng.permissionDenialPct || 0).toFixed(0)}%`, 'watch if rising'],
    ];
    cardsEl.innerHTML = cards
      .map(([label, value, sub]) => `<div class="card"><div class="kpi-label">${label}</div><div class="kpi-value">${value}</div><div class="kpi-sub">${sub}</div></div>`)
      .join('');

    const ob = eng.onboarding;
    onbEl.innerHTML = funnelBars(
      [
        ['Opened app first time', 'onboarding_start', ob.onboardingStart],
        ['Signed in with Apple', 'auth_complete', ob.authComplete],
        ['Granted Screen Time access', 'permission_granted', ob.permissionGranted],
        ['Chose apps to block', 'apps_selected', ob.appsSelected],
        ['Reached dashboard', 'onboarding_complete', ob.onboardingComplete],
      ],
      ob.onboardingStart || 0,
      'No onboarding events this period.'
    );

    const inv = eng.invite;
    invEl.innerHTML = funnelBars(
      [
        ['Invite codes created', 'invite_created', inv.inviteCreated],
        ['Shared to partner', 'invite_shared', inv.inviteShared],
        ['Partner entered code', 'invite_entered', inv.inviteEntered],
      ],
      inv.inviteCreated || 0,
      'No invite events this period.'
    );
  }

  function renderRevenue(m: any) {
    const rev = m.revenue;
    const el = document.getElementById('rev-cards') as HTMLElement;
    const cards: [string, string, string][] = [
      ['Ad earnings', rev?.admobAvailable ? fmtUsd(rev.adEarningsUsd) : '—', rev?.admobAvailable ? 'rewarded video' : 'connects once AdMob is set up'],
      ['Impressions / eCPM', rev?.admobAvailable ? `${fmtNum(rev.adImpressions)} / ${fmtUsd(rev.adEcpmUsd)}` : '—', rev?.admobAvailable ? `match rate ${(rev.adMatchRatePct || 0).toFixed(0)}%` : 'connects once AdMob is set up'],
      [
        'Willpower Waivers',
        rev?.ascRevenueAvailable ? fmtNum(rev.waiversAsc) : '—',
        rev?.ascRevenueAvailable
          ? `${fmtUsd(rev.waiversAscUsd)} (ASC) · GA4 events (incl. test purchases): ${fmtNum(rev.purchaseComplete)}`
          : 'connects once ASC access is set up',
      ],
      [
        'Support LockPact',
        rev?.ascRevenueAvailable ? fmtNum(rev.supportAsc.small + rev.supportAsc.medium + rev.supportAsc.large) : '—',
        rev?.ascRevenueAvailable
          ? `${fmtUsd(rev.supportAscUsd)} (ASC) · GA4 events (incl. test purchases): ${fmtNum(rev.tipSent)}`
          : 'connects once ASC access is set up',
      ],
    ];
    el.innerHTML = cards
      .map(([label, value, sub]) => `<div class="card"><div class="kpi-label">${label}</div><div class="kpi-value">${value}</div><div class="kpi-sub">${sub}</div></div>`)
      .join('');
  }

  function renderAcquisition(m: any) {
    const acq = m.acquisition;
    const ph = m.productHealth;
    const funnelEl = document.getElementById('funnel') as HTMLElement;
    const noteEl = document.getElementById('funnel-note') as HTMLElement;
    const ascRowsEl = document.getElementById('asc-rows') as HTMLElement;
    const webRowsEl = document.getElementById('web-rows') as HTMLElement;

    const stages: Array<{ label: string; value: number | null; source: string }> = [
      { label: 'Site visits', value: acq?.vercelAvailable ? acq.siteVisits : null, source: 'Vercel' },
      { label: 'Store page views', value: null, source: 'ASC (blocked — see agent-log)' },
      { label: 'Downloads', value: acq?.ascAvailable ? acq.downloads : null, source: 'ASC' },
      { label: 'Signed in', value: ph?.newUsers ?? null, source: 'Firestore' },
    ];
    const maxValue = Math.max(1, ...stages.map((s) => s.value ?? 0));
    funnelEl.innerHTML = stages
      .map((s) => {
        const heightPx = s.value !== null ? Math.max(4, Math.round((s.value / maxValue) * 96)) : 4;
        const numText = s.value !== null ? fmtNum(s.value) : '—';
        return `<div><div class="f-bar" style="height:${heightPx}px;"></div><div class="f-num">${numText}</div><div class="f-lbl">${s.label}</div><div class="f-conv">${s.source}</div></div>`;
      })
      .join('');
    noteEl.textContent = acq?.vercelAvailable
      ? `Top referrers: ${(acq.topReferrers || []).map((r: any) => r.referrer).slice(0, 3).join(' · ') || 'none yet'} — /invite page: ${fmtNum(acq.inviteVisitsWindowTotal)} visits`
      : 'Connects once Vercel access is set up.';

    ascRowsEl.innerHTML = acq?.ascAvailable
      ? `<div class="row"><span class="k">App Store units this period</span><span class="v">${fmtNum(acq.downloads)}</span></div><div class="row"><span class="k muted">Source-type breakdown (search/browse/referral)</span><span class="v muted">connects once ASC page-view analytics is bootstrapped</span></div>`
      : '<div class="row"><span class="k muted">Connects once ASC access is set up.</span></div>';

    webRowsEl.innerHTML = acq?.vercelAvailable
      ? `<div class="row"><span class="k">Unique visits this period</span><span class="v">${fmtNum(acq.siteVisits)}</span></div><div class="row"><span class="k">Invite-link landings (/invite)</span><span class="v">${fmtNum(acq.inviteVisitsWindowTotal)}</span></div>`
      : '<div class="row"><span class="k muted">Connects once Vercel access is set up.</span></div>';
  }

  function starString(rating: number): string {
    const clamped = Math.max(0, Math.min(5, Math.round(rating)));
    return '★★★★★☆☆☆☆☆'.slice(5 - clamped, 10 - clamped);
  }

  function renderQuality(m: any) {
    const rv = m.reviews;
    const cardsEl = document.getElementById('qual-cards') as HTMLElement;
    const cards: [string, string, string][] = [
      ['App Store rating', rv?.available ? `${rv.averageRating.toFixed(1)} (${fmtNum(rv.ratingCount)})` : '—', rv?.available ? '' : 'connects once the reviews source has run'],
      ['Crash-free sessions', '—', 'not instrumented — gap (no Crashlytics)'],
      ['iOS 18+ share', '—', 'connects in a follow-up (GA4 device dims not fetched yet)'],
    ];
    cardsEl.innerHTML = cards
      .map(([label, value, sub]) => `<div class="card"><div class="kpi-label">${label}</div><div class="kpi-value">${value}</div><div class="kpi-sub">${sub}</div></div>`)
      .join('');

    const reviewsEl = document.getElementById('qual-reviews') as HTMLElement;
    if (rv?.available && rv.recentReviews?.length > 0) {
      reviewsEl.innerHTML = rv.recentReviews
        .map(
          (r: any) =>
            `<div class="review"><span class="stars">${starString(r.rating)}</span> <b style="font-size:12px;">"${r.title}"</b> — <span style="color:var(--color-text-secondary);">${r.excerpt}</span> <span class="tech">${r.date}</span></div>`
        )
        .join('');
    } else {
      reviewsEl.innerHTML = '<div class="row"><span class="k muted">No reviews yet, or the reviews source hasn’t run.</span></div>';
    }
  }

  function renderPeriodMetricsError(status: number) {
    const errMsg = `<div class="row"><span class="k muted">Server error (HTTP ${status}) — data unavailable</span></div>`;
    (document.getElementById('cmp') as HTMLElement).textContent = `Server error (HTTP ${status}) — could not load period metrics.`;
    (document.getElementById('signals') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('pact-bars') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('unlock-response-row') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('eng-cards') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('onb-bars') as HTMLElement).innerHTML = '';
    (document.getElementById('inv-bars') as HTMLElement).innerHTML = '';
    (document.getElementById('rev-cards') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('funnel') as HTMLElement).innerHTML = '';
    (document.getElementById('funnel-note') as HTMLElement).textContent = `Server error (HTTP ${status}) — data unavailable`;
    (document.getElementById('asc-rows') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('web-rows') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('qual-cards') as HTMLElement).innerHTML = errMsg;
    (document.getElementById('qual-reviews') as HTMLElement).innerHTML = '';
  }

  document.getElementById('snap-btn')?.addEventListener('click', async () => {
    const pre = document.getElementById('snap-prev') as HTMLElement;
    if (pre.style.display === 'block') {
      pre.style.display = 'none';
      return;
    }
    if (!idToken) return;
    try {
      const res = await fetch(`/api/admin/snapshot?${windowQueryParams(currentWindow)}`, {
        headers: { Authorization: `Bearer ${idToken}` },
      });
      pre.textContent = res.ok
        ? await res.text()
        : `Server error (HTTP ${res.status}) — snapshot unavailable.`;
    } catch (err) {
      console.error('[admin] snapshot fetch failed:', err);
      pre.textContent = 'Network error — snapshot unavailable.';
    }
    pre.style.display = 'block';
  });
</script>
