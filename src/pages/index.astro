---
export const prerender = true;
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PactShowcase from '../components/PactShowcase.astro';
import Differentiators from '../components/Differentiators.astro';
import WhatLockPactIs from '../components/WhatLockPactIs.astro';
import SocialProof from '../components/SocialProof.astro';
import FAQ from '../components/FAQ.astro';
import BlogPreview from '../components/BlogPreview.astro';
import DownloadCTA from '../components/DownloadCTA.astro';

const startHere = [
  {
    href: '/blog/accountability-partner-app-phone-addiction/',
    title: 'Accountability partner apps',
    desc: 'How a partner-held lock works, and who it suits.',
  },
  {
    href: '/blog/best-free-app-blocker-iphone-2026/',
    title: 'Best free app blockers for iPhone',
    desc: 'Honest reviews of every major free option.',
  },
  {
    href: '/blog/lock-screen-time-settings-partner-passcode/',
    title: 'Give your partner the passcode',
    desc: 'Use iOS Lock Screen Time Settings so someone else holds the key.',
  },
  {
    href: '/blog/apps-that-let-a-friend-control-your-screen-time/',
    title: 'Apps where a friend controls your screen time',
    desc: 'Every app that puts another person in the approval loop.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'LockPact',
  operatingSystem: 'iOS',
  applicationCategory: 'HealthApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: 'Mutual screen time accountability. Your partner holds the key.',
  url: 'https://lockpact.app',
  downloadUrl: 'https://apps.apple.com/app/lockpact/id6759302382',
  /* aggregateRating — add after 10+ real App Store reviews
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: 'XX',
  },
  */
};
---

<PageLayout
  title="Screen Time Accountability With a Partner | LockPact"
  description="Lock your apps together. Only your partner can unlock them. LockPact is the free iOS app for mutual screen time accountability for couples and friends."
  structuredData={structuredData}
>
  <Hero />
  <HowItWorks />
  <PactShowcase />
  <Differentiators />
  <WhatLockPactIs />
  <SocialProof />
  <FAQ />
  <section class="max-w-[1200px] mx-auto px-6 section-sm" id="start-here">
    <p class="text-label uppercase text-center mb-3" style="color: var(--color-accent);">
      Start here
    </p>
    <h2 class="text-section-title text-center mb-10" style="color: var(--color-text-primary);">
      New to screen time accountability?
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-[900px] mx-auto">
      {startHere.map((item) => (
        <a href={item.href} class="lp-card block rounded-2xl p-6 transition-all group">
          <h3 class="text-card-title leading-snug mb-2 group-hover:opacity-80 transition-opacity" style="color: var(--color-text-primary);">
            {item.title}
          </h3>
          <p class="text-sm leading-snug m-0" style="color: var(--color-text-secondary);">
            {item.desc}
          </p>
        </a>
      ))}
    </div>
  </section>
  <BlogPreview />
  <DownloadCTA campaign="home" />
</PageLayout>
