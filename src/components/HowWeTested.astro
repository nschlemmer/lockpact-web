---
// Collapsed "Sources" box at the end of a post (Round 6c). Plain English: one sentence, the links, the policy.
interface Props {
  checkedOn?: string;
  sources?: { label: string; url: string }[];
}
const { checkedOn, sources = [] } = Astro.props;
const fromApple = sources.some((s) => s.url.includes('support.apple.com'));
---

<details class="lp-sources mt-12 px-5 py-4 rounded-xl text-sm" style="background: var(--color-bg-secondary); border: 1px solid var(--color-card-border); color: var(--color-text-secondary);">
  <summary class="font-bold cursor-pointer" style="color: var(--color-text-primary);">Sources</summary>
  <p class="mt-3 mb-2">
    {fromApple ? <>Steps checked against Apple's iOS 27 guides</> : <>Checked against the sources below</>}{checkedOn ? <> on {checkedOn}</> : null}. We re-check every 90 days. <a href="/editorial-policy/">Editorial policy</a>.
  </p>
  {sources.length > 0 && (
    <ul class="m-0 pl-5 list-disc">
      {sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
    </ul>
  )}
</details>
