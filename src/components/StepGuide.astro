---
/**
 * StepGuide: a clickable step list with one phone screen per step.
 * Every step is a real <ol><li>, every screenshot is an <img src srcset> in the HTML at load. Interaction only
 * changes which screen is visible, so nothing depends on a click to be crawled or read.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Step {
  title: string;
  detail?: string;
  image: ImageMetadata;
  alt: string;
}
interface Props {
  title: string;
  steps: Step[];
  video?: { src: string; poster: string; seconds: number };
  id?: string;
  eager?: boolean;
}

const { title, steps, video, eager = false } = Astro.props;
const uid =
  Astro.props.id ??
  `g-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
// Plain (unscoped) CSS, every rule prefixed with .guide. Minified at build time and inlined so a guide page
// needs no extra stylesheet request and its HTML stays small.
const css = `
  .guide {
    /* breaks out of the 672px text column to at most 880px */
    --w: min(880px, calc(100vw - 32px));
    margin: 1.5rem calc((100% - var(--w)) / 2) 1.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-card-border);
    border-radius: 20px;
    padding: 20px;
    color: var(--color-text-primary);
    line-height: 1.5;
    text-align: left;
  }
  .guide-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .guide .guide-head h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .guide-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .guide .count {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .guide .watch {
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border: 0;
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
  }
  .guide-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 28px;
    align-items: start;
  }
  .guide ol.steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    counter-reset: s;
  }
  .guide ol.steps li {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-increment: s;
  }
  .guide .step {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    text-align: left;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 12px 14px 12px 54px;
    position: relative;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .guide .step::before {
    content: counter(s);
    position: absolute;
    left: 14px;
    top: 12px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    background: var(--color-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-card-border);
  }
  .guide .step:hover {
    background: var(--color-card);
  }
  .guide .step:focus-visible,
  .guide .nav button:focus-visible,
  .guide .watch:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .guide .step[aria-current='step'] {
    background: var(--color-card);
    border-color: var(--color-card-border);
    box-shadow: var(--color-card-shadow);
  }
  .guide .step[aria-current='step']::before {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }
  .guide .step-title {
    display: block;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-text-primary);
  }
  .guide .step-text {
    display: block;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }
  .guide .stage {
    position: sticky;
    top: 24px;
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .guide .phone {
    position: relative;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1170 / 2544;
    border-radius: 38px;
    padding: 9px;
    background: #1a1a2e;
    box-shadow: var(--color-card-shadow), 0 12px 32px rgba(0, 0, 0, 0.18);
  }
  .guide .screens {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 30px;
    overflow: hidden;
    background: #f2f2f7;
  }
  .guide .screens figure {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .guide .screens figure.is-active {
    opacity: 1;
  }
  .guide .screens img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    max-width: none;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .guide .screens figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .guide .screens .video-fig {
    visibility: hidden;
    background: #000;
  }
  .guide .screens .video-fig.is-active {
    visibility: visible;
  }
  .guide .screens video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .guide .nav {
    display: flex;
    gap: 8px;
  }
  .guide .nav button {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-text-primary);
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .guide .nav button:hover {
    border-color: var(--color-accent);
  }
  .guide .nav button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (max-width: 760px) {
    .guide {
      padding: 16px;
      border-radius: 16px;
    }
    .guide-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .guide .stage {
      position: static;
      order: -1;
    }
    .guide .phone {
      max-width: none;
      aspect-ratio: auto;
      padding: 0;
      background: none;
      box-shadow: none;
      border-radius: 0;
    }
    .guide .screens {
      height: auto;
      overflow-x: auto;
      overflow-y: hidden;
      display: flex;
      gap: 12px;
      scroll-snap-type: x mandatory;
      background: none;
      border-radius: 0;
      padding-bottom: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .guide .screens::-webkit-scrollbar {
      display: none;
    }
    .guide .screens figure {
      position: relative;
      inset: auto;
      opacity: 1;
      flex: 0 0 66%;
      max-width: 240px;
      aspect-ratio: 1170 / 2544;
      scroll-snap-align: center;
      border-radius: 26px;
      overflow: hidden;
      border: 6px solid #1a1a2e;
      background: #f2f2f7;
    }
    .guide .screens .video-fig {
      visibility: visible;
    }
    .guide .nav {
      display: none;
    }
    .guide ol.steps {
      gap: 2px;
    }
    .guide .step {
      padding: 10px 10px 10px 46px;
    }
    .guide .step::before {
      left: 10px;
      top: 10px;
      width: 26px;
      height: 26px;
    }
    .guide .screens figure {
      border-width: 4px;
      border-radius: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .guide .screens figure,
  .guide .step {
      transition: none;
    }
  }
`;
const minify = (c: string) =>
  c
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/\s+/g, ' ')
    .replace(/\s*([{};:,>])\s*/g, '$1')
    .replace(/;}/g, '}')
    .trim();

---

<section class="guide" aria-labelledby={`${uid}-title`} data-guide>
  <div class="guide-head">
    <h3 id={`${uid}-title`}>{title}</h3>
    <div class="guide-meta">
      {video && <button type="button" class="watch" data-watch hidden>Watch ({video.seconds}s)</button>}
      <span class="count" aria-live="polite" data-count>Step 1 of {steps.length}</span>
    </div>
  </div>
  <div class="guide-body">
    <ol class="steps" data-steps>
      {steps.map((s, i) => (
        <li>
          <button
            type="button"
            class="step"
            id={`${uid}-step-${i + 1}`}
            aria-controls={`${uid}-shot-${i + 1}`}
            aria-current={i === 0 ? 'step' : undefined}
          >
            <span>
              <span class="step-title">{s.title}</span>
              {s.detail && <span class="step-text">{s.detail}</span>}
            </span>
          </button>
        </li>
      ))}
    </ol>
    <div class="stage">
      <div class="phone">
        <div class="screens" data-screens>
          {steps.map((s, i) => (
            <figure id={`${uid}-shot-${i + 1}`} class:list={[{ 'is-active': i === 0 }]}>
              <Image
                src={s.image}
                alt={s.alt}
                widths={[240, 280, 480, 560]}
                sizes="(max-width: 760px) 66vw, 280px"
                loading={eager && i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption>Step {i + 1}: {s.title}</figcaption>
            </figure>
          ))}
          {video && (
            <figure class="video-fig" data-video-fig>
              <video controls muted playsinline preload="none" poster={video.poster} width="270" height="587">
                <source src={video.src} type="video/mp4" />
              </video>
              <figcaption>Video walkthrough, {video.seconds} seconds, no sound</figcaption>
            </figure>
          )}
        </div>
      </div>
      <div class="nav">
        <button type="button" data-prev aria-label="Previous step">← Back</button>
        <button type="button" data-next aria-label="Next step">Next →</button>
      </div>
    </div>
  </div>
</section>

<style is:inline set:html={minify(css)} />

<script>
  document.querySelectorAll<HTMLElement>('[data-guide]').forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('.step'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('.screens figure:not([data-video-fig])'));
    const vfig = root.querySelector<HTMLElement>('[data-video-fig]');
    const video = vfig?.querySelector('video') ?? null;
    const count = root.querySelector<HTMLElement>('[data-count]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const strip = root.querySelector<HTMLElement>('[data-screens]');
    const watch = root.querySelector<HTMLButtonElement>('[data-watch]');
    if (!count || !prev || !next || !strip || !steps.length) return;
    const mobile = window.matchMedia('(max-width: 760px)');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let cur = 0;

    const centre = (el: HTMLElement) => {
      strip.scrollTo({
        left: el.offsetLeft - (strip.clientWidth - el.clientWidth) / 2,
        behavior: calm.matches ? 'auto' : 'smooth',
      });
    };
    const leaveVideo = () => {
      if (!vfig) return;
      vfig.classList.remove('is-active');
      video?.pause();
      if (watch) watch.setAttribute('aria-pressed', 'false');
    };
    const show = (i: number, fromScroll = false) => {
      cur = Math.max(0, Math.min(steps.length - 1, i));
      leaveVideo();
      steps.forEach((s, k) => {
        if (k === cur) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      shots.forEach((f, k) => f.classList.toggle('is-active', k === cur));
      count.textContent = `Step ${cur + 1} of ${steps.length}`;
      prev.disabled = cur === 0;
      next.disabled = cur === steps.length - 1;
      if (mobile.matches && !fromScroll) centre(shots[cur]);
    };

    steps.forEach((s, k) => {
      s.addEventListener('click', () => show(k));
      s.addEventListener('keydown', (e) => {
        const key = e.key;
        let to = -1;
        if (key === 'ArrowDown' || key === 'ArrowRight') to = cur + 1;
        else if (key === 'ArrowUp' || key === 'ArrowLeft') to = cur - 1;
        else if (key === 'Home') to = 0;
        else if (key === 'End') to = steps.length - 1;
        if (to < 0) return;
        e.preventDefault();
        show(to);
        steps[cur].focus();
      });
    });
    prev.addEventListener('click', () => show(cur - 1));
    next.addEventListener('click', () => show(cur + 1));

    if (watch && vfig) {
      watch.hidden = false;
      watch.addEventListener('click', () => {
        shots.forEach((f) => f.classList.remove('is-active'));
        vfig.classList.add('is-active');
        watch.setAttribute('aria-pressed', 'true');
        count.textContent = 'Video';
        if (mobile.matches) centre(vfig);
        video?.play().catch(() => {});
      });
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!mobile.matches) return;
          entries.forEach((e) => {
            if (e.isIntersecting && e.intersectionRatio > 0.6) {
              const k = shots.indexOf(e.target as HTMLElement);
              if (k >= 0 && k !== cur) show(k, true);
            }
          });
        },
        { root: strip, threshold: [0.6] },
      );
      shots.forEach((f) => io.observe(f));
    }
    show(0, true);
  });
</script>
