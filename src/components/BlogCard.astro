---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate?: Date;
  readTime?: string;
}

const { title, description, slug, pubDate, readTime } = Astro.props;

// Cards show the publish date only. "Updated" labels live on the post page itself
// (BlogLayout), where updatedDate is set only for material content changes.
const formattedDate = pubDate
  ? pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : '';
---

<a
  href={`/blog/${slug}/`}
  class="lp-card block rounded-2xl p-6 transition-all group"
  style="border-left: 3px solid transparent;"
  onmouseover="this.style.borderLeftColor='var(--color-accent)'"
  onmouseout="this.style.borderLeftColor='transparent'"
>
  {(readTime || formattedDate) && (
    <div class="text-label mb-2.5" style="color: var(--color-accent);">
      {pubDate && (
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      )}
      {formattedDate && readTime ? ' \u00B7 ' : ''}{readTime}
    </div>
  )}
  <h3
    class="text-card-title leading-snug mb-2 group-hover:opacity-80 transition-opacity"
    style="color: var(--color-text-primary);"
  >
    {title}
  </h3>
  <p class="text-sm leading-snug m-0" style="color: var(--color-text-secondary);">
    {description}
  </p>
</a>
