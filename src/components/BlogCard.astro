---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate?: Date;
  updatedDate?: Date;
  readTime?: string;
}

const { title, description, slug, pubDate, updatedDate, readTime } = Astro.props;

// Day-precision "Updated" dates (2026-09-09, docs/content-plan-60d-2026-08.md §4
// "Dates" rule) — a card shows the later of pubDate/updatedDate, labelled "Updated"
// only when updatedDate is strictly later than pubDate (equal dates show the plain
// publish date, matching lastActivity's fallback in src/lib/posts.ts).
const isUpdated = pubDate && updatedDate && updatedDate.valueOf() > pubDate.valueOf();
const displayDate = isUpdated ? updatedDate : pubDate;
const formattedDate = displayDate
  ? displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : '';
---

<a
  href={`/blog/${slug}/`}
  class="lp-card block rounded-2xl p-6 transition-all group"
  style="border-left: 3px solid transparent;"
  onmouseover="this.style.borderLeftColor='var(--color-accent)'"
  onmouseout="this.style.borderLeftColor='transparent'"
>
  {(readTime || formattedDate) && (
    <div class="text-label mb-2.5" style="color: var(--color-accent);">
      {displayDate && (
        <time datetime={displayDate.toISOString()}>
          {isUpdated ? `Updated ${formattedDate}` : formattedDate}
        </time>
      )}
      {formattedDate && readTime ? ' \u00B7 ' : ''}{readTime}
    </div>
  )}
  <h3
    class="text-card-title leading-snug mb-2 group-hover:opacity-80 transition-opacity"
    style="color: var(--color-text-primary);"
  >
    {title}
  </h3>
  <p class="text-sm leading-snug m-0" style="color: var(--color-text-secondary);">
    {description}
  </p>
</a>
