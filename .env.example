# Stripe (existing — Support LockPact checkout)
STRIPE_SECRET_KEY=

# /admin dashboard — server-side, READ-ONLY Firestore access.
# JSON key for the `lockpact-dashboard-read` service account
# (roles/datastore.viewer only — IAM denies writes). Keys-guide step 2.
# Paste the whole downloaded JSON as a single-line string.
FIREBASE_READONLY_SA=

# /admin dashboard — public Firebase web client config (safe to expose).
# Firebase Console → Project settings → General → Your apps → Web app → SDK config.
# Used for Sign in with Apple (signInWithPopup) only — no other auth provider.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# App Store Connect campaign-link attribution (per-page install tracking).
# Generated once in ASC → App Analytics → Acquisition → Campaigns → create any
# campaign link → copy the `pt=` value. Server/build-time only — never expose as
# PUBLIC_. When unset, every App Store link on the site falls back to the bare,
# unattributed URL (safe — nothing breaks, attribution is just off).
ASC_PROVIDER_TOKEN=
